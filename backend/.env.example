# Copy this file to `backend/.env` and fill in the values you need.
#
# `.env` is gitignored; this template is not -- so never put a real key here.
# Everything below is optional except where stated: the app boots and
# transcribes with an entirely empty .env. Each block says what stops working
# when its variables are missing.
#
# Format: no quotes, no spaces around the `=`. An empty value is treated
# exactly like an unset one (see core/services/ai_assist/providers.py:config).


# ---------------------------------------------------------------------------
# Speaker diarization (optional)
# ---------------------------------------------------------------------------
# Required only for "Identify speakers". Get a token from
# https://huggingface.co/settings/tokens after accepting the license terms for
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
# Without it, transcription still works; diarization is skipped.
HF_TOKEN=hf_your_token_here


# ---------------------------------------------------------------------------
# AI Assist -- Gemini (optional)
# ---------------------------------------------------------------------------
# Required for the AI Assist workspace (Correct / Academic / Translate /
# Improve / Custom). Get a key from https://aistudio.google.com/apikey.
#
# The key is read server-side only and travels in an x-goog-api-key request
# header. It is never returned by any endpoint and never reaches the browser:
# GET /api/v1/ai-capabilities/ reports only whether a key is present.
#
# Without it, GET /ai-capabilities/ reports ai_enabled=false, the AI Assist
# panel renders an "not configured" notice, and POST .../ai_revisions/ returns
# 503. The offline deterministic Academic Format and translation engines are
# unaffected -- they never call out to a provider.
GEMINI_API_KEY=AIza_your_key_here

# Model ID. Defaults to gemini-3.6-flash.
# AI_ASSIST_MODEL wins over GEMINI_MODEL, which the older fast-translation
# engine also reads -- set AI_ASSIST_MODEL when you want AI Assist on a
# different model than that engine.
#
# This is config rather than code on purpose: model IDs are retired on
# Google's schedule, so a dead default must be fixable without a deploy. That
# is not theoretical -- on 2026-08-21 the previous default (gemini-2.0-flash)
# started answering HTTP 404 "no longer available ... use models/
# gemini-3.6-flash", which is where the current default came from.
#
# IMPORTANT: Fast Translation Mode (core/services/translation/
# llm_fast_engine.py) still has the retired gemini-2.0-flash baked in as ITS
# default and will 404 the same way. Setting GEMINI_MODEL below -- not
# AI_ASSIST_MODEL -- is what repairs it, because that engine reads only
# GEMINI_MODEL.
# GEMINI_MODEL=gemini-3.6-flash
# AI_ASSIST_MODEL=

# Override the API base only for a proxy or a different API version.
# AI_ASSIST_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# Per-request provider call tuning.
# Temperature is deliberately low: these operations correct and reformat
# existing text, and invention is the failure mode to avoid.
# AI_ASSIST_TIMEOUT_SECONDS=120
# AI_ASSIST_TEMPERATURE=0.2
# AI_ASSIST_MAX_OUTPUT_TOKENS=8192


# ---------------------------------------------------------------------------
# AI Assist -- batching and rate-limit survival
# ---------------------------------------------------------------------------
# How many segments go into one provider call. On a free tier the binding
# limit is REQUESTS per minute, not tokens, so the defaults are sized to send
# as few calls as the output-token ceiling allows: an 86-segment transcript is
# about 2 calls at these values. Lower them only if you see truncated
# responses (the processor halves a failed batch and retries before degrading
# it, so truncation costs work rather than correctness).
# AI_ASSIST_MAX_ITEMS_PER_BATCH=60
# AI_ASSIST_MAX_CHARS_PER_BATCH=9000

# Seconds to pause between batches within one run. Defaults to 6, which is
# exactly AI_MAX_REQUESTS_PER_MINUTE=10 below -- a long transcript then paces
# itself instead of bursting and being refused partway through. Set it to 0 on
# a paid tier, where the pause is pure added latency.
# AI_ASSIST_INTER_BATCH_DELAY_SECONDS=6

# What happens when a 429 arrives anyway. The wait doubles each time (12s,
# 24s, 48s by default) and is capped at 60s per attempt; if the provider's
# response names its own retry delay, that figure wins. A run only fails once
# the retries are exhausted -- or immediately, when the provider asks for
# longer than the cap, since a delay measured in hours means the DAILY quota
# is gone and waiting inside the request cannot clear it.
#
# Cancel stays responsive throughout: these waits are sliced and the cancel
# flag re-checked every second, so a cancelled run reports cancelled, not
# failed.
# AI_ASSIST_RATE_LIMIT_BACKOFF_SECONDS=12
# AI_ASSIST_RATE_LIMIT_MAX_RETRIES=3


# ---------------------------------------------------------------------------
# AI Assist -- cost caps (server-side, global)
# ---------------------------------------------------------------------------
# This app has no accounts, so there is nobody to bill and nobody to quota
# individually: these are GLOBAL ceilings for the whole deployment, enforced
# before dispatch by summing the AIUsageRecord ledger (apps/transcriptions/
# ai_budget.py). Exceeding one is a clean 429 with a plain-language message,
# never a provider error leaking through.
#
# The defaults are conservative placeholders, NOT the published limits of any
# particular tier -- set them from your own tier's documented RPM/TPM/RPD.
#
# Total tokens (prompt + completion, estimated before the call) allowed per
# local calendar day, counted from local midnight.
# AI_DAILY_TOKEN_BUDGET=1000000
#
# Ceiling for one request, so a single accidental whole-transcript run cannot
# consume the day's budget. The AI Assist panel shows the estimate against
# this value and disables Send before the user spends anything.
# AI_MAX_TOKENS_PER_REQUEST=200000
#
# Trailing-60-second request ceiling, counted as ledger rows. DB-backed rather
# than Redis-backed because this deployment has no Redis (settings.py uses
# InMemoryChannelLayer and SQLite).
# AI_MAX_REQUESTS_PER_MINUTE=10


# ---------------------------------------------------------------------------
# Dynamic media discovery (JavaScript-rendered pages)
# ---------------------------------------------------------------------------
# Some pages build their audio player in the browser: the server sends an empty
# shell, and the media URL only exists after the page's own JavaScript has run.
# The static HTML scraper cannot see it, and neither can yt-dlp. For those URLs
# only, core/services/dynamic_discovery runs the page in a headless Chromium
# just long enough to observe WHICH HTTP REQUEST feeds the player, then hands
# that URL straight back to the normal download pipeline.
#
# It is the LAST stage in the generic branch, after the static scrape and
# yt-dlp have both already failed -- so a URL that works today never reaches
# it and never pays for it. Even when reached, it first checks the HTML that
# was already fetched for JS-app signals (an empty <div id="app">, a bundler
# module script, a client-side router config) and skips the browser entirely
# when they are absent.
#
# Requires the optional `playwright` package plus its browser:
#     python -m playwright install chromium
# Without those, the stage self-disables and such URLs fail as they do now.
# Nothing else in the pipeline is affected.
#
# Master switch. Turning this off restores exactly today's behaviour.
# DYNAMIC_DISCOVERY_ENABLED=true
#
# Total wall-clock budget for one discovery attempt, browser context creation
# and teardown included. A JS app that has not revealed a media request within
# this window is not going to.
# DYNAMIC_DISCOVERY_TOTAL_DEADLINE_SECONDS=25
#
# Cap on the navigation itself. Navigation deliberately waits only for the
# document to commit -- NOT for the network to go idle, which on an
# analytics-heavy page can never happen.
# DYNAMIC_DISCOVERY_NAV_TIMEOUT_SECONDS=12
#
# How long to keep watching for a media request after navigation commits.
# Bounded separately from the total budget so a page that plainly has no player
# gives up early instead of sitting out the full deadline.
# DYNAMIC_DISCOVERY_SETTLE_SECONDS=8
#
# A response typed application/octet-stream is only treated as media if it
# declares at least this many bytes. Stops a small binary chunk (a wasm blob, a
# font subset, a protobuf config) being mistaken for the recording.
# DYNAMIC_DISCOVERY_MIN_OCTET_STREAM_BYTES=65536
#
# The Chromium process is shared across jobs, because launching one costs
# roughly 0.3-1s. Each job still gets its own isolated browser context (its own
# cookie jar and storage). This is how long the shared process may sit idle
# before it is released and its ~200MB handed back.
# DYNAMIC_DISCOVERY_BROWSER_IDLE_SHUTDOWN_SECONDS=300
#
# Skips the JS-app heuristic and always attempts discovery when the stage is
# reached. For debugging, or a deployment whose sources are all JS apps. Off by
# default: launching a browser for a page with no JS-rendered player is exactly
# the wasted latency this design avoids.
# DYNAMIC_DISCOVERY_FORCE=false
#
# Extra Chromium flags, space-separated. Exists mainly for containers that need
# --no-sandbox, which is deliberately NOT a default: it disables a real
# security boundary, and this stage executes untrusted third-party JavaScript.
# DYNAMIC_DISCOVERY_BROWSER_ARGS=--no-sandbox
#
# Whether discovery may request private/loopback addresses. Off by default as a
# partial SSRF mitigation, since this stage runs untrusted page JavaScript and
# that script can ask the browser for any URL it likes. Turn it on only when
# your media genuinely lives on an internal host (an intranet app, a LAN media
# server). Analytics/ad hosts stay blocked either way.
# DYNAMIC_DISCOVERY_ALLOW_PRIVATE_HOSTS=false

# Which Chromium build to launch. Leave unset to decide automatically: try
# Playwright's default for headless mode (the small chromium-headless-shell
# download), then fall back to the full Chrome-for-Testing build via
# channel='chromium'. That fallback matters because `playwright install
# chromium` fetches those as TWO separate downloads, and one can fail (a flaky
# network, a proxy) while the other succeeds -- leaving a perfectly usable
# browser on disk that a default headless launch refuses to use.
# Set to 'chromium' to pin the full build, or to a real branded channel
# ('chrome', 'msedge') to drive a system browser instead.
# DYNAMIC_DISCOVERY_BROWSER_CHANNEL=


# ---------------------------------------------------------------------------
# AI QUALITY PIPELINE
# ---------------------------------------------------------------------------
#
# A second, adversarial pass over what the first AI pass produced: it analyses
# the source to establish domain and register, audits the candidate against the
# source for meaning, runs deterministic checks that no model is allowed to
# overrule (numbers, entities, typography, leakage), repairs verified defects,
# re-audits, and then DECIDES.
#
# The decision is the point. Without this, a revision reached status
# 'completed' the moment Gemini returned well-formed text, and there was no
# other signal -- so "the run finished" was the only available proxy for "the
# text is good". They are not the same thing, and a translation that read
# beautifully was rejected downstream for misstating a legal obligation.
#
# Runs are gated on their own axis: a revision can be status='completed' and
# quality_status='quality_review_required' at the same time.

# Which profile to run when a request does not name one.
#
#   none         (default) No quality pass. Behaviour is byte-identical to
#                before this feature existed: one AI call per batch, no extra
#                spend, no gate.
#   auto         Runs the 'translation' profile for translate operations and
#                nothing for the same-language cleanup passes. RECOMMENDED for
#                production: translation crosses a language boundary where
#                errors are invisible to any reviewer who does not read the
#                target language, which is exactly where an automated gate
#                earns its cost.
#   translation  Always run the translation profile.
#   academic     Citation/claim/notation preservation for academic passes.
#   general      Fidelity and completeness checking for cleanup passes.
#   eagle_web    Zero tolerance, for work bound for external submission:
#                refuses on MEDIUM findings, requires 0.85 auditor confidence,
#                adds commentary/leakage checks, and never falls back to a
#                local model.
#
# A client can always request a profile explicitly; this only sets the default.
# The server validates the name either way -- an unknown profile is a 400, not
# a silently skipped gate.
#
# COST: a gated run costs roughly 2-3x an ungated one (one analysis call, one
# audit call per chunk, plus a repair and re-audit only where defects were
# actually found). Chunks with no findings are never sent to the repair stage.
# AI_QUALITY_DEFAULT_PROFILE=none

# How many repair -> re-audit rounds before giving up and returning
# QUALITY_REVIEW_REQUIRED. Overrides the profile's own figure.
#
# Bounded absolutely at 5 in code (engine.ABSOLUTE_MAX_ITERATIONS) regardless
# of what is set here: a profile is data and this is operator input, and
# neither should be able to authorize an unbounded spend loop. The loop also
# stops early on its own when a repair pass returns text identical to its
# input, since a loop that is not converging will not converge.
# AI_QUALITY_MAX_ITERATIONS=2

# Audit chunk size. An audit chunk carries the source AND the candidate, so it
# covers roughly twice the text of an AI_ASSIST batch.
#
# Deliberately larger than the translation batch: terminology drift and
# completeness are only visible ACROSS a span, and a chunk of one segment can
# no more detect an inconsistent rendering than a single word can. Lowering
# these too far makes the audit cheaper and materially worse at the two things
# it is uniquely able to catch.
# AI_QUALITY_AUDIT_MAX_ITEMS=40
# AI_QUALITY_AUDIT_MAX_CHARS=12000

# How much of the source the analysis stage reads to establish domain,
# register, terminology and entities. Sampled from the head AND the tail --
# a lecture opens with administrative throat-clearing and only reaches its
# subject minutes in, so a head-only sample mis-classifies exactly the long
# material where getting the domain right matters most.
#
# Classifying a two-hour lecture in full would cost more than the translation
# it exists to protect.
# AI_QUALITY_ANALYSIS_SAMPLE_CHARS=6000

# ---------------------------------------------------------------------------
# EAGLE WEB SESSION (benchmark and probe scripts only)
# ---------------------------------------------------------------------------
#
# The full Cookie request header for translation.eaglewebcommerce.com, used by
# the scripts in backend/ that download a task's source media for benchmarking.
# Nothing in the served application reads this -- per-job credentials for real
# jobs travel through TranscriptionJob.site_auth_headers instead.
#
# This exists because those scripts previously each carried a live session
# cookie, an XSRF-TOKEN and a cf_clearance value as string literals. backend/
# is not gitignored, so `git add -A` was one command away from committing a
# client's production session to the repository.
#
# Obtain it by signing in and copying the Cookie header from DevTools. It
# expires; when a script reports a login redirect, refresh this value.
# EAGLE_COOKIE=

# ===========================================================================
# HIGH-VOLUME PRESET -- 60-120 tasks/day at ~20 minutes of audio each
# ===========================================================================
#
# Copy this block wholesale for that workload. Every number is derived from a
# measured run (Eagle Web task 4199: 5.9 min audio, 5,151 source characters,
# 3,980 tokens to translate, 6,313 more for analysis + audit).
#
# THE BINDING LIMIT IS REQUESTS, NOT TOKENS, and the free-tier allowance is
# PER MODEL. A live probe of one key found gemini-3.6-flash refusing at 20
# requests/day while three flash-lite models on the SAME key answered
# immediately. Choosing the model is the single highest-leverage setting here.
#
# Budget at these values, for a correct -> edit -> translate workflow:
#     1 correct + 1 translate + 2 gate          = 4 per task
#     70 tasks/day at ~20 min audio             = 280 requests, ~3.3M tokens
#     with an academic pass as well             = 350 requests
#     at 120 tasks/day                          = 480 requests, ~5.7M tokens
# against a published flash-lite free allowance of ~1,000-1,500 requests/day.

# 1. THE MODEL. Flash-Lite has an allowance in the low thousands per day and
#    was measured producing correct legal French on a real task. The premium
#    Flash models have a token free allowance and will stop you at ~20/day.
AI_ASSIST_MODEL=gemini-3.1-flash-lite

# 2. ONE REQUEST PER TRANSLATION. A 20-minute transcript is ~17,500 source
#    characters, so these ceilings keep it in a single call. Output tokens
#    are sized automatically per batch (providers.size_output_tokens) -- the
#    old fixed 8,192 cap was only ~1.2x what 20 minutes actually emits, and
#    exceeding it does not fail cleanly: the JSON truncates, which becomes a
#    schema error, which becomes a split-and-retry, which turns one request
#    into three.
AI_ASSIST_MAX_ITEMS_PER_BATCH=300
AI_ASSIST_MAX_CHARS_PER_BATCH=40000

# 3. ONE REQUEST PER AUDIT. Source and target together, in one chunk.
AI_QUALITY_AUDIT_MAX_ITEMS=500
AI_QUALITY_AUDIT_MAX_CHARS=60000
AI_QUALITY_ANALYSIS_SAMPLE_CHARS=4000

# 4. THE PROFILE, AND WHERE IT APPLIES.
#
#    'volume' stops at Tier 1: it detects everything and reports it, but does
#    not automatically repair. On the real runs observed so far the repair
#    loop was ~90% of the cost and once spent three passes chasing a finding
#    that turned out to be false, so a human deciding is both cheaper and, on
#    that evidence, more accurate.
#
#    The 'auto:' prefix is what makes a multi-step workflow affordable. A
#    typical job is: AI-correct the ASR -> edit by hand -> optionally format
#    academically -> translate. Only the LAST step produces text that leaves
#    the building, and only translation crosses a language boundary where a
#    reviewer cannot see a defect by eye. 'auto:volume' therefore gates the
#    translation and leaves the working steps alone.
#
#    Measured on that exact flow (correct -> edit -> translate, task 4199):
#      AI correct      1 request
#      manual edits    0 requests
#      translate       1 request
#      quality gate    2 requests
#      total           4 requests, ~14k tokens, ~18 seconds
#
#    Writing a bare profile name instead ('volume') gates EVERY operation --
#    correct, academic and translate alike -- which roughly triples the cost
#    to audit prose the next step overwrites. Use it only if you mean it.
#
#    Use 'auto:eagle_web' for zero-tolerance on submission-bound work.
#    Leave AI_QUALITY_DEFAULT_PROFILE=none to keep the gate off entirely.
AI_QUALITY_DEFAULT_PROFILE=auto:volume

# 5. THE CEILINGS. Set below the provider's real allowance on purpose:
#    refusing a request we could have made costs one delayed task, while
#    discovering the ceiling by hitting it kills a run mid-flight. Confirm
#    your project's live numbers at https://aistudio.google.com/rate-limit
#    and raise these to match. Gemini's daily quota resets midnight Pacific.
AI_MAX_REQUESTS_PER_DAY=900
AI_DAILY_TOKEN_BUDGET=6000000

# 6. PACING. Flash-Lite free tier allows ~15-30 requests/minute. With one
#    request per stage there is no need to pace within a run, but concurrency
#    across simultaneous jobs still matters.
AI_ASSIST_INTER_BATCH_DELAY_SECONDS=0
AI_MAX_REQUESTS_PER_MINUTE=12
AI_MAX_CONCURRENT_REQUESTS=2
